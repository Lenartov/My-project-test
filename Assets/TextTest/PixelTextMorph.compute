#pragma kernel BuildOldPoints
#pragma kernel BuildNewPoints
#pragma kernel InitParticles
#pragma kernel SimulateParticles

Texture2D<float4> _MaskTex;

int2 _TextureSize;
int2 _GridSize;
int _SampleStep;
int _FlipY;

float2 _TextWorldSize;
float _CenterSpawnRadius;
float _T;
float _Chaos;

int _MaxParticles;
int _ForceFromCenter;
int _MatchedCount;
int _UnmatchedOldCount;
int _UnmatchedNewCount;
int _VisibleParticleCount;

struct PointGPU
{
    float2 pos;
};

struct ParticleGPU
{
    float2 start;
    float2 target;
    float2 pos;
    float seed;
    float active;
    float mode;
    float scale;
};

AppendStructuredBuffer<PointGPU> _OldPoints;
AppendStructuredBuffer<PointGPU> _NewPoints;

StructuredBuffer<PointGPU> _OldPointsRead;
StructuredBuffer<PointGPU> _NewPointsRead;

RWStructuredBuffer<ParticleGPU> _Particles;

float Hash11(float p)
{
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float2 Hash21(float p)
{
    float x = Hash11(p);
    float y = Hash11(p + 17.17);
    return float2(x, y);
}

float EaseInOut(float t)
{
    return t * t * (3.0 - 2.0 * t);
}

float2 GridToWorld(int2 gridPos)
{
    int px = gridPos.x * _SampleStep + _SampleStep / 2;
    int py = gridPos.y * _SampleStep + _SampleStep / 2;

    float u = ((float) px + 0.5) / (float) _TextureSize.x;
    float v = ((float) py + 0.5) / (float) _TextureSize.y;

    if (_FlipY == 1)
        v = 1.0 - v;

    float2 centered = float2(u - 0.5, v - 0.5);
    return centered * _TextWorldSize;
}

[numthreads(8, 8, 1)]
void BuildOldPoints(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _GridSize.x || id.y >= _GridSize.y)
        return;

    int px = id.x * _SampleStep + _SampleStep / 2;
    int py = id.y * _SampleStep + _SampleStep / 2;

    if (px >= _TextureSize.x || py >= _TextureSize.y)
        return;

    float4 c = _MaskTex.Load(int3(px, py, 0));

    if (c.a > 0.2)
    {
        PointGPU p;
        p.pos = GridToWorld(int2(id.x, id.y));
        _OldPoints.Append(p);
    }
}

[numthreads(8, 8, 1)]
void BuildNewPoints(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _GridSize.x || id.y >= _GridSize.y)
        return;

    int px = id.x * _SampleStep + _SampleStep / 2;
    int py = id.y * _SampleStep + _SampleStep / 2;

    if (px >= _TextureSize.x || py >= _TextureSize.y)
        return;

    float4 c = _MaskTex.Load(int3(px, py, 0));

    if (c.a > 0.2)
    {
        PointGPU p;
        p.pos = GridToWorld(int2(id.x, id.y));
        _NewPoints.Append(p);
    }
}

[numthreads(128, 1, 1)]
void InitParticles(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _MaxParticles)
        return;

    ParticleGPU p;
    p.start = float2(0, 0);
    p.target = float2(0, 0);
    p.pos = float2(0, 0);
    p.seed = Hash11((float) i + 1.0);
    p.active = 0;
    p.mode = 0;
    p.scale = 0;

    if (i >= (uint) _VisibleParticleCount)
    {
        _Particles[i] = p;
        return;
    }

    uint matchedCount = (uint) _MatchedCount;
    uint unmatchedOldCount = (uint) _UnmatchedOldCount;

    uint unmatchedOldStart = matchedCount;
    uint unmatchedNewStart = matchedCount + unmatchedOldCount;

    float2 randomOffset = (Hash21(i + 91.7) - 0.5) * _CenterSpawnRadius;

    if (i < matchedCount)
    {
        p.start = _OldPointsRead[i].pos;
        p.target = _NewPointsRead[i].pos;
        p.mode = 0;
        p.scale = 1;
        p.active = 1;
    }
    else if (i >= unmatchedOldStart && i < unmatchedNewStart)
    {
        p.start = _OldPointsRead[i].pos;

        float2 localDisappearPoint = float2(p.start.x, 0.0) + randomOffset;

        p.target = localDisappearPoint;
        p.mode = 2;
        p.scale = 1;
        p.active = 1;
    }
    else
    {
        p.target = _NewPointsRead[i].pos;

        float2 localLetterSpawn = float2(p.target.x, 0.0) + randomOffset;

        p.start = localLetterSpawn;
        p.mode = 1;
        p.scale = 0;
        p.active = 1;
    }

    p.pos = p.start;
    _Particles[i] = p;
}

[numthreads(128, 1, 1)]
void SimulateParticles(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _MaxParticles)
        return;

    ParticleGPU p = _Particles[i];

    if (p.active < 0.5)
    {
        _Particles[i] = p;
        return;
    }

    float t = saturate(_T);
    float e = EaseInOut(t);

    float2 randomVec = Hash21(p.seed * 123.4) - 0.5;
    float len = max(length(randomVec), 0.0001);
    float2 dir = randomVec / len;

    float wave = sin(t * 3.14159265);
    float2 chaosOffset = dir * wave * _Chaos * Hash11(p.seed * 55.1);

    p.pos = lerp(p.start, p.target, e) + chaosOffset;

    if (p.mode == 1)
    {
        p.scale = e;
    }
    else if (p.mode == 2)
    {
        p.scale = 1.0 - e;
    }
    else
    {
        p.scale = 1.0;
    }

    _Particles[i] = p;
}